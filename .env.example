# ─────────────────────────────────────────────────────────────────────────────
# The Diagram — environment. Copy to .env.local and fill in what you use.
# Only ANTHROPIC_API_KEY is required; everything else degrades gracefully.
# Restart the dev server after changing anything here.
# ─────────────────────────────────────────────────────────────────────────────

# ── You ──────────────────────────────────────────────────────────────────────
# What Spectre calls you (also used in the Chronicle). Leave blank for "the user".
NEXT_PUBLIC_USER_NAME=

# ── Core model (required) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Web search for chat + deep research (free tier at tavily.com) ────────────
TAVILY_API_KEY=

# ── Voice ────────────────────────────────────────────────────────────────────
# Cloud TTS (Cartesia) and cloud STT (Groq Whisper)
CARTESIA_API_KEY=
GROQ_API_KEY=
# Any Cartesia voice id (default: a public library voice)
# CARTESIA_VOICE_ID=
# Default TTS provider: cartesia | chatterbox
TTS_PROVIDER=cartesia
# Optional local voice stack (see docker-compose.yml)
# CHATTERBOX_URL=http://localhost:8004
# CHATTERBOX_VOICE=default.wav
# WHISPER_URL=http://localhost:8005

# ── Integrations (optional) ──────────────────────────────────────────────────
# Google Calendar — OAuth client from Google Cloud Console.
# Add http://localhost:3000/api/auth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Oura Ring — OAuth app from cloud.ouraring.com.
# Redirect URI: http://localhost:3000/api/oura/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# OURA_WEBHOOK_URL=

# Web push notifications — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Local stack (optional) ───────────────────────────────────────────────────
# MEM0_API_URL=http://localhost:8000
# LLAMA_URL=http://localhost:8013
# LLM_N_CTX=131072
# PLAYWRIGHT_URL=http://localhost:8009

# ── Scribe schedule (hours, 24h clock) ───────────────────────────────────────
# SCRIBE_MORNING_HOUR=
# SCRIBE_AFTERNOON_HOUR=
# SCRIBE_NIGHT_HOUR=

# ── Remote access ────────────────────────────────────────────────────────────
# Extra hostnames allowed to reach the dev server (e.g. your Tailscale name), comma-separated
# DEV_ORIGINS=
